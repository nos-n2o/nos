        type string;
        description "Add an IP address to an interface.";
      }
    }
    leaf routing_table {
      type string;
      description "Associate a routing table with a broadcast domain's SVI.";
    }
    leaf ospf_profile {
      type string;
      description "Associate an OSPF profile with an interface, subinterface, or broadcast domain.";
    }
    leaf ospfv3_profile {
      type string;
      description "Run OSPFv3 on this attach point under a profile.";
    }
    leaf vni {
      type uint32;
      description "Give a broadcast domain a VXLAN Network Identifier (EVPN).";
    }
    leaf rd {
      type string;
      description "Set a broadcast domain's EVPN Route Distinguisher.";
    }
    leaf-list route_targets_import {
      type string;
      description "Add an EVPN Route Target to a broadcast domain's import or export list.";
    }
    leaf-list route_targets_export {
      type string;
      description "Add an EVPN Route Target to a broadcast domain's import or export list.";
    }
    container vtep_source {
      description "Set the address a broadcast domain's VXLAN tunnels are sourced from.";
      choice variant {
        case Interface {
          container Interface {
            leaf interface {
              type string;
            }
            leaf label {
              type string;
            }
          }
        }
        case Loopback {
          container Loopback {
            leaf label {
              type string;
            }
          }
        }
      }
    }
    leaf mac_redistribute {
      type string;
      description "Redistribute a broadcast domain's MAC addresses into a BGP instance (EVPN).";
    }
    leaf arp_redistribute {
      type string;
      description "Also originate a broadcast domain's ARP/ND neighbours as EVPN MAC+IP routes.";
    }
    leaf connected_redistribute {
      type string;
      description "Originate a broadcast domain's own (SVI) addresses as EVPN MAC+IP routes.";
    }
    leaf neigh_suppress {
      type boolean;
      description "Answer ARP/ND locally for EVPN-learned hosts (ARP/ND suppression).";
    }
    leaf max_remote_macs {
      type uint32;
      description "Cap the remote MAC addresses installed for this domain from EVPN.";
    }
    leaf stp_instance {
      type uint16;
      description "Map the domain's VLAN to an MST instance.";
