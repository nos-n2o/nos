  container logging {
    description "Log export settings.";
    list syslog {
      key "name";
      description "Create or delete a remote syslog collector.";
      leaf name {
        type string;
      }
      leaf address {
        type inet:ip-address;
        description "Set a syslog collector's address.";
      }
      leaf port {
        type uint16;
        description "Set a syslog collector's port.";
      }
      leaf transport {
        type enumeration {
          enum "Udp";
          enum "Tcp";
          enum "Tls";
        }
        description "Set a syslog collector's transport.";
      }
      leaf routing_table {
        type string;
        description "Send syslog from inside a routing table's VRF.";
      }
      leaf level {
        type enumeration {
          enum "Trace";
          enum "Debug";
          enum "Info";
          enum "Warn";
          enum "Error";
        }
        description "Set a syslog collector's minimum severity.";
      }
      leaf facility {
        type enumeration {
          enum "Local0";
          enum "Local1";
          enum "Local2";
          enum "Local3";
          enum "Local4";
          enum "Local5";
          enum "Local6";
          enum "Local7";
        }
        description "Set a syslog collector's facility.";
      }
      container tls {
        description "Configure how a TLS syslog collector is authenticated.";
        leaf trust_anchor {
          type string;
          description "Trust the collector's certificate through a CA (RFC 5425 §4.2.1).";
        }
        leaf fingerprint {
          type string;
          description "Trust one collector certificate by its SHA-256 fingerprint (RFC 5425 §4.2.2).";
        }
        leaf server_name {
          type string;
          description "Set the DNS name the collector's certificate must carry.";
        }
        leaf allow_tls12 {
          type boolean;
          description "Also allow TLS 1.2 with classical key exchange, for collectors that need RFC 9662.";
        }
      }
    }
  }
