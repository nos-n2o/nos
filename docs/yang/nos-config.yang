    leaf detect_multiplier {
      type uint8;
      description "Set the detection multiplier.";
    }
    leaf passive {
      type boolean;
      description "Make the BFD role passive.";
    }
    leaf minimum_ttl {
      type uint8;
      description "Set the minimum accepted TTL.";
    }
    leaf shutdown {
      type boolean;
      description "Administratively shut down the profile's sessions.";
    }
    container auth {
      description "Set BFD authentication.";
      leaf key_id {
        type uint8;
        description "Set BFD authentication.";
      }
      leaf method {
        type enumeration {
          enum "SimplePassword";
          enum "KeyedMd5";
          enum "MeticulousMd5";
          enum "KeyedSha1";
          enum "MeticulousSha1";
        }
        description "Set BFD authentication.";
      }
      leaf key {
        type string;
        description "Set BFD authentication.";
      }
    }
    leaf echo_mode {
      type enumeration {
        enum "Disabled";
        enum "Affiliated";
        enum "Unaffiliated";
      }
      description "Set the BFD Echo function mode.";
    }
    leaf echo_interval {
      type uint32;
      description "Set the BFD Echo interval.";
    }
    leaf padded_pdu_size {
      type uint16;
      description "Pad BFD Control packets to a size.";
    }
    leaf mode {
      type enumeration {
        enum "Async";
        enum "Sbfd";
      }
      description "Choose classical or Seamless BFD.";
    }
    leaf sbfd_remote_discriminator {
      type inet:ipv4-address;
      description "Set the S-BFD discriminator to probe.";
    }
  }
  container sbfd_reflector {
    description "Answer Seamless BFD probes.";
    leaf-list discriminators {
      type inet:ipv4-address;
      description "Add an S-BFD discriminator to answer for.";
    }
    leaf-list allow_from {
      type inet:ip-prefix;
      description "Only answer probes from these sources.";
    }
  }
  container spanning_tree {
    description "Configure spanning tree.";
    leaf mode {
      type enumeration {
        enum "Rstp";
        enum "Mstp";
        enum "RapidPvst";
        enum "Disabled";
      }
      description "Choose the spanning-tree protocol.";
    }
    leaf priority {
      type uint16;
      description "Set the bridge priority.";
    }
    leaf hello_time {
      type uint8;
      description "Set the hello time.";
    }
    leaf max_age {
      type uint8;
      description "Set the maximum age.";
    }
    leaf forward_delay {
      type uint8;
      description "Set the forward delay.";
    }
    leaf tx_hold_count {
      type uint8;
      description "Set the transmit hold count.";
    }
    leaf max_hops {
      type uint8;
      description "Set the MSTP hop budget.";
    }
    leaf force_version {
      type enumeration {
        enum "Stp";
        enum "Rstp";
      }
      description "Force a protocol version.";
    }
    container region {
      description "Set the MST region identity.";
      leaf name {
        type string;
        description "Set the MST region identity.";
      }
      leaf revision {
        type uint16;
        description "Set the MST region identity.";
      }
    }
    list mst_instances {
      key "id";
      description "Define an MST instance.";
      leaf id {
        type uint16;
      }
      leaf priority {
        type uint16;
        description "Set this bridge's priority in the instance.";
      }
    }
  }
  list stp_port_profiles {
    key "name";
    description "Create or delete a spanning-tree port profile.";
    leaf name {
      type string;
    }
    leaf edge_port {
      type enumeration {
        enum "Admin";
        enum "Auto";
        enum "Disabled";
      }
      description "Set the edge-port behaviour.";
    }
    leaf link_type {
      type enumeration {
        enum "Auto";
        enum "PointToPoint";
        enum "Shared";
      }
      description "Set the link type.";
    }
    leaf cost {
      type uint32;
      description "Set the port path cost.";
    }
    leaf priority {
      type uint8;
      description "Set the port priority.";
    }
    leaf bpdu_guard {
      type boolean;
      description "Shut the port when a BPDU arrives.";
    }
    leaf bpdu_guard_recovery {
      type uint32;
      description "Bring an err-disabled port back.";
    }
    leaf bpdu_filter {
      type boolean;
      description "Neither send nor process BPDUs.";
    }
    leaf root_guard {
      type boolean;
      description "Never become the root port.";
    }
    leaf loop_guard {
      type boolean;
      description "Block the port when BPDUs stop.";
    }
    leaf restricted_tcn {
      type boolean;
      description "Do not propagate topology changes from this port.";
    }
    list mst_instances {
      key "id";
      description "Tune the port in an MST instance.";
      leaf id {
        type uint16;
      }
      leaf cost {
        type uint32;
        description "Set the port cost in the instance.";
      }
      leaf priority {
        type uint8;
        description "Set the port priority in the instance.";
      }
    }
  }
  list acls {
    key "name";
    description "Create or delete an access list.";
    leaf name {
      type string;
    }
    leaf default_action {
      type enumeration {
        enum "Permit";
        enum "Deny";
      }
      description "Set what happens when no rule matches.";
    }
    list rules {
      key "name";
      description "Add or edit a rule.";
      leaf name {
        type string;
      }
      leaf action {
        type enumeration {
          enum "Permit";
          enum "Deny";
        }
        description "Set what the rule does.";
      }
      leaf protocol {
        type string;
        description "Match an IP protocol.";
      }
      leaf source {
        type inet:ip-prefix;
        description "Match the source prefix.";
      }
      leaf destination {
        type inet:ip-prefix;
        description "Match the destination prefix.";
      }
      leaf source_port {
        type string;
        description "Match the TCP/UDP source port.";
      }
      leaf destination_port {
        type string;
        description "Match the TCP/UDP destination port.";
      }
      leaf established {
        type boolean;
        description "Match TCP segments of an existing connection.";
      }
      leaf icmp_type {
        type uint8;
        description "Match the ICMP message type.";
      }
      leaf icmp_code {
        type uint8;
        description "Match the ICMP message code.";
      }
      leaf log {
        type boolean;
        description "Log the packets the rule matches.";
      }
    }
  }
  container admin {
    description "The admin keystore: secrets other sections reference by label.";
    list keys {
      key "label";
      description "Create or delete a labelled key.";
      leaf label {
        type string;
      }
      leaf secret {
        type string;
        description "Set a key's secret.";
      }
    }
  }
}
