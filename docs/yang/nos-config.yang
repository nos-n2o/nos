      type string;
      description "Attach a spanning-tree port profile.";
    }
    leaf acl_in {
      type string;
      description "Filter the IP packets received on this link.";
    }
    leaf acl_out {
      type string;
      description "Filter the IP packets sent on this link.";
    }
