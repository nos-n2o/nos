        enum "CustomerBridge";
      }
      description "Set the LLDP destination group an interface uses.";
    }
    list subinterfaces {
      key "tag";
      description "Create or delete a subinterface: one 802.1q tag's L3 attach point.";
      leaf tag {
        type uint16;
      }
      list addresses {
        key "address";
        description "Add an IP address to an interface.";
        leaf address {
          type inet:ip-prefix;
        }
        leaf label {
          type string;
          description "Add an IP address to an interface.";
        }
